<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0-M2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.qmjy</groupId>
    <artifactId>admin-division-extractor</artifactId>
    <version>1.0.0</version>
    <name>admin-division-extractor</name>
    <description>Extract administrative division boundaries from OpenStreetMap .osm.pbf files into OSMB-style GeoJSON</description>

    <properties>
        <java.version>17</java.version>
        <osmosis.version>0.49.2</osmosis.version>
        <fastutil.version>8.5.19</fastutil.version>
        <!-- osmosis-pbf carries protobuf gencode from the 3.x era; protobuf 4.x
             runtimes log "Vulnerable protobuf generated type" warnings for it.
             3.25.5 includes the runtime fix for GHSA-h4h5-3hr4-j3g2 and is
             fully compatible with the old gencode. -->
        <protobuf-java.version>3.25.5</protobuf-java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Streaming GeoJSON output -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>

        <!-- OpenStreetMap PBF parsing -->
        <dependency>
            <groupId>org.openstreetmap.osmosis</groupId>
            <artifactId>osmosis-core</artifactId>
            <version>${osmosis.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openstreetmap.osmosis</groupId>
            <artifactId>osmosis-pbf</artifactId>
            <version>${osmosis.version}</version>
        </dependency>

        <!-- Primitive collections to keep node/way indexes memory-friendly -->
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>${fastutil.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
